# Configuración de Producción para GCP (Google Cloud Platform)
# Copiar este archivo como application-prod.properties y editar con tus valores

spring.application.name=BirthdayApp
server.port=8080

# Security Configuration
spring.security.user.name=admin
spring.security.user.password=Admin2024!

# MongoDB Atlas Configuration
# IMPORTANTE: Reemplaza esta línea con tu Connection String de MongoDB Atlas
spring.data.mongodb.uri=mongodb+srv://birthdayapp_user:TU_PASSWORD@cluster.xxxxx.mongodb.net/birthdayapp?retryWrites=true&w=majority&appName=Effeta
spring.data.mongodb.database=birthdayapp

# Logging Configuration
logging.level.root=INFO
logging.level.com.effeta.BirthdayApp=INFO
logging.file.name=logs/birthdayapp.log
logging.file.max-size=10MB
logging.file.max-history=30

# Production Settings
spring.devtools.restart.enabled=false
